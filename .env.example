# Banco de dados (PostgreSQL). Nunca compartilhar entre ambientes.
DATABASE_URL="postgresql://user:password@localhost:5432/lista_enxoval?schema=public"

# Conexão direta (sem pooler/PgBouncer), usada só por `prisma migrate` — ver
# datasource.directUrl em prisma/schema.prisma. Em dev local, sem pooler
# envolvido, use o mesmo valor de DATABASE_URL. Em produção com Neon/Supabase/
# etc., a plataforma injeta essa variável automaticamente ao conectar o banco.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/lista_enxoval?schema=public"

# Segredo usado para assinar o cookie de sessão (staff e pais). Gere um valor
# aleatório forte em produção, ex.: `openssl rand -base64 32`.
AUTH_SECRET="change-me"

# URL pública base da aplicação (usada em links de lista, QR Code e webhooks).
APP_URL="http://localhost:3000"

# Gateway de pagamento (Fase 2). "manual" = sem gateway, usado por vendas presenciais.
PAYMENT_PROVIDER="manual"
PAYMENT_API_KEY=""

# Upload de imagem de produto (src/lib/storage.ts). Em produção na Vercel,
# conectar um Blob store injeta BLOB_READ_WRITE_TOKEN automaticamente — não
# defina isso aqui. Sem essa variável, o upload grava em /public/uploads
# (comportamento padrão em dev local).

# Envio de e-mail transacional. "console" apenas loga em desenvolvimento.
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""

# Minutos que uma reserva de checkout online permanece válida (seção 55).
RESERVATION_TTL_MINUTES="15"
